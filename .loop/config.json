{
  "gates": ["./tests/run.sh"],
  "backlog": {
    "source": "github",
    "list": "bash adapters/github.sh list --label loop:ready",
    "report": "bash adapters/github.sh report",
    "writeback": "comment"
  },
  "rubrics": [
    { "glob": "**/*.sh", "rubric": "code" },
    { "glob": "**/*.md", "rubric": "docs" }
  ],
  "maxRetries": 3,
  "autonomy": { "commit": true, "mainMerge": false, "maxConsecutiveFails": 2 }
}
